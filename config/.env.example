# Secrets referenced by config/mcp-servers.json.
# Copy the lines you need into ~/.zshrc (macOS) or your PowerShell $PROFILE (Windows).
# NEVER commit real values.

# Vercel MCP — https://vercel.com/account/tokens
export VERCEL_API_TOKEN=""

# Sentry MCP — https://sentry.io/settings/account/api/auth-tokens/
export SENTRY_AUTH_TOKEN=""

# GitHub MCP — a GitHub token with the scopes you need (repo, read:org).
# Alternatively drop the "github" entry from mcp-servers.json and let
# Claude Code handle GitHub auth interactively via `claude mcp`.
export GITHUB_MCP_TOKEN=""
